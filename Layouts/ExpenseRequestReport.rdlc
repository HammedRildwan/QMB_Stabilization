                <TablixMember>
                  <Group Name="ApprovalDetails">
                    <Filters>
                      <Filter>
                        <FilterExpression>=Trim(Fields!ApprovalApprover.Value &amp; "")</FilterExpression>
                        <Operator>Like</Operator>
                        <FilterValues>
